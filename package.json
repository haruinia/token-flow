{
  "name": "desktop-browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "serve": "node dist/headless.js",
    "build": "tsup && vite build --config apps/console/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "browser:install": "playwright install chromium",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "package": "npm run build && electron-builder --dir",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "test:login": "node scripts/login-smoke.mjs"
  },
  "dependencies": {
    "@cua-sample/contracts": "*",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.1",
    "openai": "^6.25.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "tsx": "^4.20.5"
  },
  "build": {
    "appId": "local.browseragent.desktop",
    "productName": "Browser Agent",
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright*/**"
    ],
    "extraResources": [
      {
        "from": "sidecars",
        "to": "sidecars"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "Local desktop browser agent with persistent Chromium and CLIProxyAPI",
  "author": "Browser Agent contributors"
}
